{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "what-can-my-mac-play",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "STEAM_LIBRARY_LOOKUP_ENABLED": false
  },
  "ratelimits": [
    {
      "name": "STEAM_API_ROUTE_RATE_LIMITER",
      "namespace_id": "597037684",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "STEAM_LIBRARY_USER_RATE_LIMITER",
      "namespace_id": "2599512933",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "STEAM_DAILY_BUDGET",
        "class_name": "SteamDailyBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SteamDailyBudget"]
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
