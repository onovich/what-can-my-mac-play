{
  "name": "what-can-my-mac-play",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.7.0"
  },
  "scripts": {
    "dev": "vite",
